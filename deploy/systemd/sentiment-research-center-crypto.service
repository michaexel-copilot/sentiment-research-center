# Daily crypto run. Started by sentiment-research-center-crypto.timer; installed by deploy/install.sh. See docs/DEPLOYMENT.md.
[Unit]
Description=Sentiment Research Center: daily crypto run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=srcenter
Group=srcenter
WorkingDirectory=/var/lib/sentiment-research-center
Environment=HOME=/var/lib/sentiment-research-center
Environment=SRC_HOME=/var/lib/sentiment-research-center
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/sentiment-research-center/browsers
Environment=PATH=/var/lib/sentiment-research-center/.local/bin:/opt/sentiment-research-center/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1

# Only SRC_HOME (data, reports, Claude Code login) is writable.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sentiment-research-center
PrivateTmp=true
ExecStart=/opt/sentiment-research-center/venv/bin/src run --universe observed --class crypto
TimeoutStartSec=3h
